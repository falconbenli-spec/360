# Open Duet settings for the 360 server. Copy to /opt/open-duet/open-dots.env (mode 0600).
# install.sh fills TOKEN_ENCRYPTION_KEYS for you; never regenerate it on an existing install.

# The public address people open (scheme + host only).
OPEN_DOTS_PUBLIC_URL=https://duet.example.com

# Encrypts stored credentials. Back this up somewhere else; without it the data is unreadable.
TOKEN_ENCRYPTION_KEYS=

# Agents run only when this is true.
LOCAL_EXECUTION_ENABLED=true
# Lets agents run commands and edit files (needed for `gh`). Every command still asks for
# approval in the app unless you save an "Always allow" rule for it.
LOCAL_TOOLS_ENABLED=true

# GitHub token for the PR-reviewer agent (fine-grained PAT: Pull requests read/write,
# Contents read, Metadata read on the repositories it should review).
GH_TOKEN=
# Pass GH_TOKEN into the engine's environment (the app passes nothing else by default).
OPEN_DOTS_ENGINE_ENV=GH_TOKEN

# How long an unattended run waits for an approval before it is denied (seconds).
LOCAL_APPROVAL_TIMEOUT_SECONDS=900

# Keep off on a server.
LOOPBACK_TRUST=off
